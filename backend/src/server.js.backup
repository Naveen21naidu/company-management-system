const express = require("express");
const cors = require("cors");
const bcrypt = require("bcryptjs");
const jwt = require("jsonwebtoken");
const { Pool, Client } = require("pg");
require("dotenv").config();

const app = express();

app.use(cors());
app.use(express.json());

const PORT = process.env.PORT || 5000;
const JWT_SECRET = process.env.JWT_SECRET;

const masterPool = new Pool({
    connectionString: process.env.MASTER_DATABASE_URL,
    ssl: { rejectUnauthorized: false }
});


// =====================================================
// DATABASE HELPERS
// =====================================================

function validateOrgId(orgId) {
    return /^[a-zA-Z0-9]+$/.test(orgId);
}

function getDatabaseName(orgId) {
    return `org_${orgId.toLowerCase()}`;
}

async function createTenantDatabase(databaseName) {
    if (!/^org_[a-zA-Z0-9_]+$/.test(databaseName)) {
        throw new Error("Invalid database name");
    }

    try {
        await masterPool.query(
            `CREATE DATABASE "${databaseName}"`
        );
    } catch (error) {
        // Database already exists
        if (error.code !== "42P04") {
            throw error;
        }
    }
}

function createTenantPool(databaseName) {
    const url = new URL(process.env.MASTER_DATABASE_URL);
    url.pathname = `/${databaseName}`;

    return new Pool({
        connectionString: url.toString(),
        ssl: { rejectUnauthorized: false }
    });
}


// =====================================================
// CREATE TENANT TABLES
// =====================================================

async function createTenantTables(databaseName) {

    const pool = createTenantPool(databaseName);

    try {

        await pool.query(`

            CREATE TABLE IF NOT EXISTS roles (
                id SERIAL PRIMARY KEY,
                name VARCHAR(100) UNIQUE NOT NULL
            );

            CREATE TABLE IF NOT EXISTS permissions (
                id SERIAL PRIMARY KEY,
                name VARCHAR(100) UNIQUE NOT NULL
            );

            CREATE TABLE IF NOT EXISTS role_permissions (
                role_id INTEGER REFERENCES roles(id) ON DELETE CASCADE,
                permission_id INTEGER REFERENCES permissions(id) ON DELETE CASCADE,
                PRIMARY KEY(role_id, permission_id)
            );

            CREATE TABLE IF NOT EXISTS users (
                id SERIAL PRIMARY KEY,
                name VARCHAR(150) NOT NULL,
                email VARCHAR(255) UNIQUE NOT NULL,
                password_hash TEXT NOT NULL,
                role_id INTEGER REFERENCES roles(id),
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            );

            CREATE TABLE IF NOT EXISTS products (
                id SERIAL PRIMARY KEY,
                name VARCHAR(200) NOT NULL,
                description TEXT,
                price NUMERIC(12,2) NOT NULL,
                stock INTEGER NOT NULL DEFAULT 0,
                is_published BOOLEAN DEFAULT FALSE,
                created_by INTEGER REFERENCES users(id),
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            );

            CREATE TABLE IF NOT EXISTS customers (
                id SERIAL PRIMARY KEY,
                name VARCHAR(150) NOT NULL,
                email VARCHAR(255) UNIQUE NOT NULL,
                password_hash TEXT,
                phone VARCHAR(50),
                address TEXT,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            );

            CREATE TABLE IF NOT EXISTS orders (
                id SERIAL PRIMARY KEY,
                customer_id INTEGER REFERENCES customers(id),
                status VARCHAR(30) DEFAULT 'ORDERED',
                total_amount NUMERIC(12,2) DEFAULT 0,
                shipping_address TEXT,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            );

            CREATE TABLE IF NOT EXISTS order_items (
                id SERIAL PRIMARY KEY,
                order_id INTEGER REFERENCES orders(id) ON DELETE CASCADE,
                product_id INTEGER REFERENCES products(id),
                quantity INTEGER NOT NULL,
                unit_price NUMERIC(12,2) NOT NULL
            );

        `);

        // Roles
        await pool.query(`
            INSERT INTO roles(name)
            VALUES
            ('Admin'),
            ('Inventory Manager'),
            ('Account Manager')
            ON CONFLICT(name) DO NOTHING
        `);

        // Permissions
        const permissions = [
            "view_product",
            "create_product",
            "update_product",
            "delete_product",
            "publish_product",
            "view_orders",
            "update_order_status",
            "manage_users"
        ];

        for (const permission of permissions) {
            await pool.query(
                `INSERT INTO permissions(name)
                 VALUES($1)
                 ON CONFLICT(name) DO NOTHING`,
                [permission]
            );
        }

        // Admin gets all permissions
        await pool.query(`
            INSERT INTO role_permissions(role_id, permission_id)
            SELECT r.id, p.id
            FROM roles r CROSS JOIN permissions p
            WHERE r.name = 'Admin'
            ON CONFLICT DO NOTHING
        `);

        // Inventory Manager permissions
        await pool.query(`
            INSERT INTO role_permissions(role_id, permission_id)
            SELECT r.id, p.id
            FROM roles r
            JOIN permissions p
            ON p.name IN (
                'view_product',
                'create_product',
                'update_product',
                'delete_product',
                'publish_product'
            )
            WHERE r.name = 'Inventory Manager'
            ON CONFLICT DO NOTHING
        `);

        // Account Manager permissions
        await pool.query(`
            INSERT INTO role_permissions(role_id, permission_id)
            SELECT r.id, p.id
            FROM roles r
            JOIN permissions p
            ON p.name IN (
                'view_product',
                'view_orders',
                'update_order_status'
            )
            WHERE r.name = 'Account Manager'
            ON CONFLICT DO NOTHING
        `);

        console.log(`Tenant database ready: ${databaseName}`);

    } finally {
        await pool.end();
    }
}


// =====================================================
// AUTH MIDDLEWARE
// =====================================================

function authenticate(req, res, next) {

    const header = req.headers.authorization;

    if (!header || !header.startsWith("Bearer ")) {
        return res.status(401).json({
            message: "Authentication required"
        });
    }

    const token = header.split(" ")[1];

    try {

        const decoded = jwt.verify(token, JWT_SECRET);

        req.user = decoded;

        next();

    } catch (error) {

        return res.status(401).json({
            message: "Invalid or expired token"
        });
    }
}


function authorize(...requiredPermissions) {

    return async (req, res, next) => {

        try {

            const pool = createTenantPool(req.user.databaseName);

            const result = await pool.query(`
                SELECT p.name
                FROM role_permissions rp
                JOIN permissions p
                ON p.id = rp.permission_id
                WHERE rp.role_id = $1
            `, [req.user.roleId]);

            await pool.end();

            const permissions = result.rows.map(r => r.name);

            const allowed = requiredPermissions.every(
                p => permissions.includes(p)
            );

            if (!allowed) {
                return res.status(403).json({
                    message: "Forbidden"
                });
            }

            next();

        } catch (error) {

            console.error(error);

            res.status(500).json({
                message: "Authorization error"
            });
        }
    };
}


